<?xml version="1.0"?>
<ruleset name="X AI Assistant">
	<description>X AIアシスタント用のWordPressコーディング規約です。</description>
	<file>x-ai-assistant.php</file>
	<file>includes</file>
	<file>uninstall.php</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<config name="ignore_warnings_on_exit" value="1"/>
	<rule ref="WordPress-Core"/>
	<rule ref="PHPCompatibilityWP">
		<properties>
			<property name="testVersion" value="7.4-"/>
		</properties>
	</rule>
</ruleset>
