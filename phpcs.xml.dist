<?xml version="1.0"?>
<ruleset name="X AI Assistant">
	<description>WordPress coding standards for X AI Assistant.</description>
	<file>x-ai-assistant.php</file>
	<file>includes</file>
	<file>uninstall.php</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP">
		<properties>
			<property name="testVersion" value="7.4-"/>
		</properties>
	</rule>
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>includes/class-xaia-*.php</exclude-pattern>
	</rule>
</ruleset>
